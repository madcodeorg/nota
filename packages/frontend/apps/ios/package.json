{
  "name": "@nota/ios",
  "version": "0.1.12",
  "description": "Nota iOS application",
  "type": "module",
  "private": true,
  "browser": "src/index.tsx",
  "scripts": {
    "build": "affine bundle",
    "dev": "affine bundle --dev",
