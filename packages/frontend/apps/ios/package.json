    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@nota/component": "workspace:*",
    "@nota/core": "workspace:*",
    "@nota/env": "workspace:*",
    "@nota/graphql": "workspace:*",
    "@nota/i18n": "workspace:*",
    "@nota/infra": "workspace:^",
    "@nota/mobile-shared": "workspace:*",
    "@nota/nbstore": "workspace:*",
    "@nota/track": "workspace:*",
    "async-call-rpc": "^6.4.2",
