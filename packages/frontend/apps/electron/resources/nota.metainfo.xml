<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<component type="desktop-application">
  <id>nota</id>
  <name>Nota</name>
  <summary>Productivity and note-taking app</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <url type="homepage">https://github.com/madcodeorg/nota</url>
  <url type="bugtracker">https://github.com/madcodeorg/nota/issues</url>
  <url type="vcs-browser">https://github.com/madcodeorg/nota</url>
  <developer id="pro.nota.app">
    <name>nota</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>Office</category>
  </categories>
  <keywords>
    <keyword>notes</keyword>
    <keyword>canvas</keyword>
  </keywords>
  <branding>
    <color type="primary">#1e96eb</color>
  </branding>
  <recommends>
    <display_length compare="ge">800</display_length>
    <internet>first-run</internet>
  </recommends>
  <provides>
    <mediatype>x-scheme-handler/nota</mediatype>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>tablet</control>
    <control>touch</control>
  </supports>
  <description>
    <p>Write, Draw, Plan, All at Once.</p>
    <p>Nota is a local-first workspace for documents, whiteboards, databases, meetings, and optional on-device AI.</p>
    <p>Features</p>
    <ul>
      <li>Write your way to better productivity. Build up your content like blocks and let your ideas run wild.</li>
      <li>Draw and visualise with ease and creativity. Visualise your creativity with others. No constraints, limited only by your imagination.</li>
      <li>Plan and track your work with linked pages and local databases.</li>
    </ul>
  </description>
  <launchable type="desktop-id">nota.desktop</launchable>
</component>
