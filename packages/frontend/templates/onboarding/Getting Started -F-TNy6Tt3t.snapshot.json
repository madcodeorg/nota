              "type": "text",
              "text": {
                "$blocksuite:internal:text$": true,
                "delta": [
                  {
                    "insert": "Meeting Settings controls speech models and recording. Allow the microphone or system-audio permissions you need, then record and save the transcript as an editable workspace page."
                  }
                ]
              },
              "collapsed": false
            },
            "children": []
          },
          {
