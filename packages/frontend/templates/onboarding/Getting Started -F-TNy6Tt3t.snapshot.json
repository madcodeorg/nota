            "version": 1,
            "props": {
              "type": "text",
              "text": {
                "$blocksuite:internal:text$": true,
                "delta": [
                  {
                    "insert": "AI Settings lets you download a local text model for chat, summaries, and note actions. The first model download needs internet access. Hosted providers are optional and use your own API key when selected."
                  }
                ]
              },
              "collapsed": false
            },
            "children": []
          },
          {
            "type": "block",
