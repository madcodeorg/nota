GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_AUTH_BROKER_URL=

# Hosted Google OAuth broker only. Keep the secret on the broker/server, never
# in the app bundle. Calendar support requires calendar.readonly in the scope
# list for new Google sign-ins.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/drive.appdata https://www.googleapis.com/auth/calendar.readonly

# Local AI backend. The desktop app manages its own ONNX text models.
# Download the selected model in AI Settings; no separate server is required.
NOTA_AI_PROVIDER=local
NOTA_AI_LOCAL_MODEL=qwen3.5-2b-onnx-q4f16

# Optional external OpenAI-compatible local endpoint. Leave these unset to use
# the managed model above. Select/configure an external model in AI Settings.
# NOTA_AI_MODEL=your-local-model
# NOTA_AI_LOCAL_BASE_URL=http://localhost:11434/v1
# NOTA_AI_LOCAL_API_KEY=ollama

# Image generation can use OpenAI, Google, or an OpenAI-compatible local image endpoint.
NOTA_AI_IMAGE_PROVIDER=local
NOTA_AI_LOCAL_IMAGE_MODEL=local-image-model
NOTA_AI_OPENAI_IMAGE_MODEL=gpt-image-1-mini
NOTA_AI_GOOGLE_IMAGE_MODEL=imagen-4.0-fast-generate-001

# Nota-scoped AI tools. Shell is read-only, restricted to the Nota workspace,
# and disabled by default.
NOTA_AI_TOOLS_ENABLED=true
NOTA_AI_WORKSPACE_SEARCH_TOOL_ENABLED=true
NOTA_AI_WEB_CRAWL_TOOL_ENABLED=true
NOTA_AI_SHELL_TOOL_ENABLED=false
NOTA_AI_TOOL_MAX_STEPS=50

# Optional local MCP servers. Read-only tools can run in chat; write tools
# require an approved action. Keep credentials out of this example.
NOTA_AI_MCP_ENABLED=false
NOTA_AI_MCP_CONFIG={}

# Optional hosted providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
